{
    "name":  "@norr/cli",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "bin":  {
                "norr":  "./src/index.ts"
            },
    "scripts":  {
                    "dev":  "tsx src/index.ts",
                    "build":  "tsc -p tsconfig.json --noEmit",
                    "typecheck":  "tsc -p tsconfig.json --noEmit",
                    "lint":  "tsc -p tsconfig.json --noEmit",
                    "test":  "tsx --test test/*.test.ts"
                },
    "dependencies":  {
                         "@norr/sdk":  "workspace:*",
                         "@norr/confidential":  "workspace:*",
                         "@norr/tally":  "workspace:*"
                     }
}
